###############
### GENERAL ###
###############
# or `production` if is run in production
ENVIRONMENT=development
DATABASE_CONNECTION_POOL_SIZE=10

###############
### LoadGen ###
###############
LOADGEN_PORT=1111
# or `mongo` if you want to test MongoDB
LOADGEN_TARGET_DB=postgres
LOADGEN_CONNECTION_POOL_SIZE=10
# Host ports for two Docker Compose loadgen services.
# Both containers listen on LOADGEN_PORT internally.
LOADGEN_POSTGRES_PORT=1111
LOADGEN_MONGO_PORT=1112

###############
### Express ###
###############
EXPRESS_PORT=1234
EXPRESS_HOST=localhost 
VITE_API_URL=http://localhost:1234
# Express calls these loadgen endpoints. Use service names from Docker or
# localhost ports for local development.
LOADGEN_POSTGRES_URL=http://localhost:1111
LOADGEN_MONGO_URL=http://localhost:1112
# Used by Express to return dashboard links to the frontend.
GRAFANA_URL=http://localhost:3000

###########
### Vue ###
###########
# vite default, no changes
VUE_PORT=5173
VUE_HOST=localhost
EXPRESS_CORS_ORIGIN=http://localhost:5173

################
### POSTGRES ###
################

# `postgres` if accessed from docker
POSTGRES_HOST=localhost

POSTGRES_PORT=5432
POSTGRES_DB=coursework_db
POSTGRES_USER=coursework_user
POSTGRES_PASSWORD=coursework_password

#############
### MONGO ###
#############

# `mongo` if accessed from docker
MONGO_HOST=localhost

MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=coursework_user
MONGO_INITDB_ROOT_PASSWORD=coursework_password
MONGO_INITDB_DATABASE=coursework_db

# MongoDB databases initialized for model comparison
MONGO_NESTED_DATABASE=coursework_nested
MONGO_NORMALIZED_DATABASE=coursework_normalized

###############
### Grafana ###
###############
# Set default admin credentials
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin
GF_SECURITY_ALLOW_EMBEDDING=true
GRAFANA_RENDERER_TOKEN=coursework_renderer_token_change_me

# Disable authentication and allow anonymous access with Admin role
GF_AUTH_ANONYMOUS_ENABLED="true"
GF_AUTH_ANONYMOUS_ORG_ROLE="Admin"
GF_AUTH_DISABLE_LOGIN_FORM="true"
GF_AUTH_DISABLE_SIGNOUT_MENU="true"
GF_SECURITY_DISABLE_INITIAL_ADMIN_CREATION="true"

# Light mode
GF_USERS_DEFAULT_THEME=light