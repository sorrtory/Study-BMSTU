digraph CFG {
  node [shape=box];
  0 [label="B0:\lb_1 = 2\la_1 = 0\l%t0 = b_1 < 10\lif %t0 goto B1 else B2\l"];
  1 [label="B1:\la_2 = 1\lgoto B3\l"];
  2 [label="B2:\l%t1 = b_1 + 1\lb_2 = %t1\lgoto B3\l"];
  3 [label="B3:\la_3 = phi(B1: a_2, B2: a_1)\lb_3 = phi(B1: b_1, B2: b_2)\lreturn a_3\l"];
  0 -> 1;
  0 -> 2;
  1 -> 3;
  2 -> 3;
}
